{
  "name": "@denysskobalo/db",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply denysskobalodev-db --local --config ../../apps/api-gateway/wrangler.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply denysskobalodev-db --remote --config ../../apps/api-gateway/wrangler.jsonc",
	"check-types": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.32.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.23.0",
    "wrangler": "4.0.0"
  }
}
